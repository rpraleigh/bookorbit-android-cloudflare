<!--
  Adaptive-icon foreground for BookOrbit PRM-CF: an open book with a tilted ring and a small moon
  circling it. Original artwork for this app. Everything sits inside the 66dp centre safe zone of the
  108x108 adaptive viewport. The same drawable is the monochrome layer for themed icons (Android 13+).
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Ring, drawn first so the book passes in front of its far side. -->
    <group
        android:pivotX="54"
        android:pivotY="54"
        android:rotation="-22">
        <path
            android:pathData="M24,54 a30,11 0 1,0 60,0 a30,11 0 1,0 -60,0"
            android:strokeColor="#FFE9B44C"
            android:strokeWidth="2.4"
            android:strokeLineCap="round" />
    </group>

    <!-- Left page. -->
    <path
        android:fillColor="#FFF6EBD0"
        android:pathData="M52.5,47 C47,43.2 38.5,42.2 31,44 L31,71 C38.5,69.2 47,70.2 52.5,74 Z" />
    <!-- Right page. -->
    <path
        android:fillColor="#FFF6EBD0"
        android:pathData="M55.5,47 C61,43.2 69.5,42.2 77,44 L77,71 C69.5,69.2 61,70.2 55.5,74 Z" />

    <!-- Near side of the ring and the moon, drawn last so they cross in front of the book. -->
    <group
        android:pivotX="54"
        android:pivotY="54"
        android:rotation="-22">
        <path
            android:pathData="M24,54 a30,11 0 0,0 60,0"
            android:strokeColor="#FFE9B44C"
            android:strokeWidth="2.4"
            android:strokeLineCap="round" />
        <path
            android:fillColor="#FFE9B44C"
            android:pathData="M84,54 m-3.6,0 a3.6,3.6 0 1,0 7.2,0 a3.6,3.6 0 1,0 -7.2,0" />
    </group>
</vector>
